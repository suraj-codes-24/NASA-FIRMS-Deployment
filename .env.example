# ============================================
# IGNIS — Environment Configuration
# ============================================
# Copy this file to .env and fill in your values
# DO NOT commit .env to version control

# ----- NASA FIRMS API -----
FIRMS_MAP_KEY=your_nasa_firms_api_key_here

# ----- Database (PostgreSQL + PostGIS) -----
POSTGRES_USER=ignis
POSTGRES_PASSWORD=ignis_secure_password_change_me
POSTGRES_DB=ignis_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://ignis:ignis_secure_password_change_me@postgres:5432/ignis_db
DATABASE_URL_SYNC=postgresql://ignis:ignis_secure_password_change_me@postgres:5432/ignis_db

# ----- Redis -----
REDIS_URL=redis://redis:6379/0

# ----- Security -----
SECRET_KEY=replace-this-with-a-strong-random-secret-key
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=1440

# ----- Application -----
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000

# ----- FIRMS Ingestion -----
INGESTION_INTERVAL_HOURS=3
INDIA_BBOX=68.0,6.0,97.5,37.5

# ----- ML Model -----
ML_MODEL_PATH=app/ml/models/classifier_v1.joblib
ML_MODEL_VERSION=v1.0

# ----- Alert Thresholds -----
ALERT_FRP_THRESHOLD=200
ALERT_INDUSTRIAL_FIRE_CONFIDENCE=0.85

# ----- CORS -----
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost

# ----- Celery -----
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
